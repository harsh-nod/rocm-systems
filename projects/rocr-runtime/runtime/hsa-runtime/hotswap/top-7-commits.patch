+  uint32_t check;
+  std::memcpy(&check, &elf[64 + 4], 4);
+  assert(check == 0xAAAAAAAAu);
+  std::memcpy(&check, &elf[64 + 8], 4);
+  assert(check == 0xBBBBBBBBu);
+  std::memcpy(&check, &elf[64 + 16], 4);

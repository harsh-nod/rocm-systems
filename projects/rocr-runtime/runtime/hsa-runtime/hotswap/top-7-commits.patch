diff --git a/projects/rocr-runtime/runtime/hsa-runtime/hotswap/tests/test_b0a0_hsaco.cpp b/projects/rocr-runtime/runtime/hsa-runtime/hotswap/tests/test_b0a0_hsaco.cpp

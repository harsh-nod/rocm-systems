+// ── gfx1250 B0→A0 patch tests ────────────────────────────────────────────────
+//
+// These tests build minimal ELFs with a .text section containing target
+// instructions, call rocr_hotswap_gfx1250_b0_to_a0() via its C wrapper,
+// and verify that the correct opcode rewrites were applied.
+
+extern "C" int rocr_hotswap_gfx1250_b0_to_a0(void* elf_data, size_t elf_size);
+
+/// Build a minimal 64-bit ELF with a .text section containing the given bytes.
+/// Returns a self-contained buffer. The .text data starts at a fixed offset.
+static std::vector<uint8_t> BuildMinimalElf(const uint8_t* text_bytes,
+                                            size_t text_size) {
+  // Minimal ELF64 layout:
+  //   [0x00]  ELF header (64 bytes)
+  //   [0x40]  .text data (text_size bytes, padded to 8-byte boundary)
+  //   [0x40 + padded_text]  section header string table (.shstrtab)
+  //   [after shstrtab]  section headers (3 entries × 64 bytes):
+  //     [0] SHN_UNDEF, [1] .text, [2] .shstrtab
+
+  const size_t text_padded = (text_size + 7) & ~7u;
+  // .shstrtab contents: "\0.text\0.shstrtab\0" = 17 bytes
+  const char shstrtab[] = "\0.text\0.shstrtab";
+  const size_t shstrtab_size = sizeof(shstrtab); // 17 bytes (includes trailing \0)
+  const size_t shstrtab_padded = (shstrtab_size + 7) & ~7u;
+
+  const size_t text_offset = 64;
+  const size_t shstrtab_offset = text_offset + text_padded;
+  const size_t shdr_offset = shstrtab_offset + shstrtab_padded;
+  const size_t total = shdr_offset + 3 * 64;
+
+  std::vector<uint8_t> elf(total, 0);
+
+  // ELF header
+  elf[0] = 0x7f; elf[1] = 'E'; elf[2] = 'L'; elf[3] = 'F';
+  elf[4] = 2;   // ELFCLASS64
+  elf[5] = 1;   // ELFDATA2LSB
+  elf[6] = 1;   // EV_CURRENT
+  elf[7] = 64;  // ELFOSABI_AMDGPU_HSA
+  // e_type = ET_DYN (3)
+  uint16_t e_type = 3;
+  std::memcpy(&elf[16], &e_type, 2);
+  // e_machine = EM_AMDGPU (224)
+  uint16_t e_machine = 224;
+  std::memcpy(&elf[18], &e_machine, 2);
+  // e_version
+  uint32_t e_version = 1;
+  std::memcpy(&elf[20], &e_version, 4);
+  // e_shoff
+  uint64_t e_shoff_val = shdr_offset;
+  std::memcpy(&elf[40], &e_shoff_val, 8);
+  // e_flags = EF_AMDGPU_MACH_AMDGCN_GFX1250 (0x49)
+  uint32_t e_flags = 0x49;
+  std::memcpy(&elf[48], &e_flags, 4);
+  // e_ehsize = 64
+  uint16_t e_ehsize = 64;
+  std::memcpy(&elf[52], &e_ehsize, 2);
+  // e_shentsize = 64
+  uint16_t e_shentsize = 64;
+  std::memcpy(&elf[58], &e_shentsize, 2);
+  // e_shnum = 3
+  uint16_t e_shnum = 3;
+  std::memcpy(&elf[60], &e_shnum, 2);
+  // e_shstrndx = 2
+  uint16_t e_shstrndx = 2;
+  std::memcpy(&elf[62], &e_shstrndx, 2);
+
+  // .text data
+  std::memcpy(&elf[text_offset], text_bytes, text_size);
+
+  // .shstrtab data
+  std::memcpy(&elf[shstrtab_offset], shstrtab, shstrtab_size);
+
+  // Section headers
+
+  // [0] SHN_UNDEF — all zeros (already zeroed)
+
+  // [1] .text
+  uint8_t* sh1 = &elf[shdr_offset + 64];
+  uint32_t sh_name_text = 1; // offset of ".text" in shstrtab
+  std::memcpy(sh1, &sh_name_text, 4);
+  uint32_t sh_type_progbits = 1; // SHT_PROGBITS
+  std::memcpy(sh1 + 4, &sh_type_progbits, 4);
+  uint64_t sh_flags = 6; // SHF_ALLOC | SHF_EXECINSTR
+  std::memcpy(sh1 + 8, &sh_flags, 8);
+  uint64_t sh_addr = 0;
+  std::memcpy(sh1 + 16, &sh_addr, 8);
+  uint64_t sh_offset_val = text_offset;
+  std::memcpy(sh1 + 24, &sh_offset_val, 8);
+  uint64_t sh_size_val = text_size;
+  std::memcpy(sh1 + 32, &sh_size_val, 8);
+
+  // [2] .shstrtab
+  uint8_t* sh2 = &elf[shdr_offset + 128];
+  uint32_t sh_name_shstrtab = 7; // offset of ".shstrtab" in shstrtab
+  std::memcpy(sh2, &sh_name_shstrtab, 4);
+  uint32_t sh_type_strtab = 3; // SHT_STRTAB
+  std::memcpy(sh2 + 4, &sh_type_strtab, 4);
+  uint64_t shstrtab_off = shstrtab_offset;
+  std::memcpy(sh2 + 24, &shstrtab_off, 8);
+  uint64_t shstrtab_sz = shstrtab_size;
+  std::memcpy(sh2 + 32, &shstrtab_sz, 8);
+
+  return elf;
+}
+
+static void TestClusterLoadPatch() {
+  // VGLOBAL format: dw0 bits[31:24]=0xEE, opcode at bits[20:13], 12 bytes total
+  // Test all 7 CLUSTER_LOAD → GLOBAL_LOAD mappings
+  struct Case { uint8_t from_op; uint8_t to_op; };
+  Case cases[] = {
+    {103, 20}, {104, 21}, {105, 23},
+    {106, 95}, {107, 96}, {108, 97}, {109, 98},
+  };
+
+  for (const auto& c : cases) {
+    // Build a 12-byte VGLOBAL instruction with other_bits preserved
+    uint32_t other_bits = 0x00001E03u; // some bits in [12:0] and [23:21]
+    uint32_t dw0 = 0xEE000000u | other_bits |
+                   (static_cast<uint32_t>(c.from_op) << 13);
+    uint32_t dw1 = 0xDEADBEEFu;
+    uint32_t dw2 = 0xCAFEBABEu;
+
+    uint8_t text[12];
+    std::memcpy(text + 0, &dw0, 4);
+    std::memcpy(text + 4, &dw1, 4);
+    std::memcpy(text + 8, &dw2, 4);
+
+    auto elf = BuildMinimalElf(text, sizeof(text));
+    int count = rocr_hotswap_gfx1250_b0_to_a0(elf.data(), elf.size());
+    assert(count == 1);
+
+    // Verify the patched dw0
+    uint32_t patched_dw0;
+    std::memcpy(&patched_dw0, &elf[64], 4);
+
+    uint32_t expected_dw0 = 0xEE000000u | other_bits |
+                            (static_cast<uint32_t>(c.to_op) << 13);
+    assert(patched_dw0 == expected_dw0);
+
+    // Verify dw1 and dw2 are untouched
+    uint32_t check_dw1, check_dw2;
+    std::memcpy(&check_dw1, &elf[68], 4);
+    std::memcpy(&check_dw2, &elf[72], 4);
+    assert(check_dw1 == 0xDEADBEEFu);
+    assert(check_dw2 == 0xCAFEBABEu);
+  }
+
+  std::cout << "TestClusterLoadPatch: PASSED\n";
+}
+
+static void TestDs2AddrPatch() {
+  // VDS format: dw0 bits[31:26]=0b110110 (0xD8), opcode at bits[25:18], 8 bytes
+  // Test all 12 DS 2-addr → single-addr mappings
+  struct Case { uint8_t from_op; uint8_t to_op; };
+  Case cases[] = {
+    {0x37, 0x36}, {0x77, 0x76}, {0x38, 0x36}, {0x78, 0x76},
+    {0x0E, 0x0D}, {0x4E, 0x4D}, {0x0F, 0x0D}, {0x4F, 0x4D},
+    {0x2E, 0x2D}, {0x6E, 0x6D}, {0x2F, 0x2D}, {0x6F, 0x6D},
+  };
+
+  for (const auto& c : cases) {
+    // Construct VDS dw0 with some preserved bits in [17:0]
+    uint32_t other_bits = 0x0002A5F7u; // bits[17:0]
+    uint32_t dw0 = 0xD8000000u | (static_cast<uint32_t>(c.from_op) << 18) |
+                   (other_bits & 0x3FFFFu);
+    uint32_t dw1 = 0x12345678u;
+
+    uint8_t text[8];
+    std::memcpy(text + 0, &dw0, 4);
+    std::memcpy(text + 4, &dw1, 4);
+
+    auto elf = BuildMinimalElf(text, sizeof(text));
+    int count = rocr_hotswap_gfx1250_b0_to_a0(elf.data(), elf.size());
+    assert(count == 1);
+
+    uint32_t patched_dw0;
+    std::memcpy(&patched_dw0, &elf[64], 4);
+
+    uint32_t expected_dw0 = 0xD8000000u | (static_cast<uint32_t>(c.to_op) << 18) |
+                            (other_bits & 0x3FFFFu);
+    assert(patched_dw0 == expected_dw0);
+
+    // Verify dw1 untouched
+    uint32_t check_dw1;
+    std::memcpy(&check_dw1, &elf[68], 4);
+    assert(check_dw1 == 0x12345678u);
+  }
+
+  std::cout << "TestDs2AddrPatch: PASSED\n";
+}
+
+static void TestSClausePatch() {
+  // SOPP format: dw0 & 0xFF800000 == 0xBF800000, s_clause opcode = bits[22:16] == 0x05
+  // s_clause has a 16-bit immediate in bits[15:0]
+  uint32_t s_clause = 0xBF800000u | (0x05u << 16) | 42u; // s_clause 42
+  uint8_t text[4];
+  std::memcpy(text, &s_clause, 4);
+
+  auto elf = BuildMinimalElf(text, sizeof(text));
+  int count = rocr_hotswap_gfx1250_b0_to_a0(elf.data(), elf.size());
+  assert(count == 1);
+
+  uint32_t patched;
+  std::memcpy(&patched, &elf[64], 4);
+  assert(patched == 0xBF800000u); // s_nop 0
+
+  // Verify s_nop is NOT patched again (s_nop opcode = 0x00, not 0x05)
+  auto elf2 = BuildMinimalElf(reinterpret_cast<uint8_t*>(&elf[64]), 4);
+  int count2 = rocr_hotswap_gfx1250_b0_to_a0(elf2.data(), elf2.size());
+  assert(count2 == 0);
+
+  std::cout << "TestSClausePatch: PASSED\n";
+}
+
+static void TestB0A0ByteBufferPatch() {
+  // Construct a 32-byte buffer with:
+  //   [0..11]  CLUSTER_LOAD_B32 (op 103, 12 bytes)
+  //   [12..19] DS_STORE_2ADDR_B32 (op 0x0E, 8 bytes)
+  //   [20..23] s_clause 7 (4 bytes)
+  //   [24..27] s_nop 0 (4 bytes, should NOT be patched)
+  //   [28..31] padding (zeros)
+
+  uint8_t text[32];
+  std::memset(text, 0, sizeof(text));
+
+  // CLUSTER_LOAD_B32: VGLOBAL, op=103

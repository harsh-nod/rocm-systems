+/// Rewrite a DS 2-addr instruction's printed assembly to its single-addr form.
+/// Handles load, store, and storexchg variants by transforming operands.
+static std::string RewriteDs2Addr(const std::string& printed_asm,
+                                   const std::string& from_mnemonic,
+                                   const std::string& to_mnemonic) {
+  // Replace the mnemonic
+  size_t start = printed_asm.find_first_not_of(" \t");
+  if (start == std::string::npos) return "";
+  size_t end = printed_asm.find_first_of(" \t", start);
+  if (end == std::string::npos) return "";
+
+  std::string operands = printed_asm.substr(end);
+
+  // Transform offset0/offset1 → offset (just use offset0 value)
+  // Remove offset1 entirely
+  {
+    size_t off0_pos = operands.find("offset0:");
+    if (off0_pos != std::string::npos) {
+      // Replace "offset0:" with "offset:"
+      operands.replace(off0_pos, 8, "offset:");
+    }
+    // Remove offset1:N
+    size_t off1_pos = operands.find("offset1:");
+    if (off1_pos != std::string::npos) {
+      size_t off1_end = off1_pos;
+      // Skip past "offset1:NNN"
+      off1_end += 8; // skip "offset1:"
+      while (off1_end < operands.size() &&
+             ((operands[off1_end] >= '0' && operands[off1_end] <= '9') ||
+              operands[off1_end] == 'x' ||
+              (operands[off1_end] >= 'a' && operands[off1_end] <= 'f') ||
+              (operands[off1_end] >= 'A' && operands[off1_end] <= 'F')))
+        off1_end++;
+      operands.erase(off1_pos, off1_end - off1_pos);
+    }
+  }
+
+  // For 2-addr instructions, we need to reduce the operand count:
+  // - Load: ds_load_2addr_b32 v[D:D+1], vA → ds_load_b32 vD, vA
+  //         (first reg of VGPR pair for dest)
+  // - Store: ds_store_2addr_b32 vA, vD0, vD1 → ds_store_b32 vA, vD0
+  //          (drop second data operand)
+  // - Xchg: ds_storexchg_2addr_rtn_b32 v[D:D+1], vA, vS0, vS1
+  //          → ds_storexchg_rtn_b32 vD, vA, vS0
+  //          (first reg of pair for vdst, drop second data)
+
+  // Parse operands into a vector split by comma
+  std::vector<std::string> ops;
+  {
+    std::string rest = operands;
+    // Trim leading whitespace
+    size_t s = rest.find_first_not_of(" \t");
+    if (s != std::string::npos) rest = rest.substr(s);
+
+    while (!rest.empty()) {
+      size_t comma = rest.find(',');
+      if (comma == std::string::npos) {
+        ops.push_back(rest);
+        break;
+      }
+      ops.push_back(rest.substr(0, comma));
+      rest = rest.substr(comma + 1);
+      s = rest.find_first_not_of(" \t");
+      if (s != std::string::npos) rest = rest.substr(s);
+    }
+  }
+
+  // Trim whitespace from each operand
+  for (auto& op : ops) {
+    size_t s = op.find_first_not_of(" \t");
+    size_t e = op.find_last_not_of(" \t");
+    if (s != std::string::npos && e != std::string::npos)
+      op = op.substr(s, e - s + 1);
+  }
+
+  // Helper to extract first register from a pair (v[N:N+1] → vN)
+  auto extractFirstOfPair = [](const std::string& reg) -> std::string {
+    size_t bracket = reg.find('[');
+    if (bracket == std::string::npos) return reg;
+    size_t colon = reg.find(':', bracket);
+    if (colon == std::string::npos) return reg;
+    std::string prefix = reg.substr(0, bracket); // "v"
+    std::string num = reg.substr(bracket + 1, colon - bracket - 1);
+    return prefix + num;
+  };
+
+  bool is_load = (from_mnemonic.find("ds_load") == 0);
+  bool is_store = (from_mnemonic.find("ds_store_") == 0 &&
+                   from_mnemonic.find("xchg") == std::string::npos);
+  bool is_xchg = (from_mnemonic.find("ds_storexchg") == 0);
+
+  std::string result = to_mnemonic;
+
+  if (is_load && ops.size() >= 2) {
+    // 2-addr load: v[D:D+1], vA [offsets...]
+    // → single: vD, vA [offset]
+    result += " " + extractFirstOfPair(ops[0]) + ", " + ops[1];
+    // Append any remaining offset operands
+    for (size_t i = 2; i < ops.size(); ++i) {
+      std::string trimmed = ops[i];
+      // Only keep if it's an offset (not offset1 which was already removed)
+      if (trimmed.find("offset") != std::string::npos) {
+        result += " " + trimmed;
+      }
+    }
+  } else if (is_store && ops.size() >= 3) {
+    // 2-addr store: vA, vD0, vD1 [offsets...]
+    // → single: vA, vD0 [offset]
+    result += " " + ops[0] + ", " + ops[1];
+    // Append offset operands (skip ops[2] which is the second data reg)
+    for (size_t i = 3; i < ops.size(); ++i) {
+      if (ops[i].find("offset") != std::string::npos) {
+        result += " " + ops[i];
+      }
+    }
+  } else if (is_xchg && ops.size() >= 4) {
+    // 2-addr xchg: v[D:D+1], vA, vS0, vS1 [offsets...]
+    // → single: vD, vA, vS0 [offset]
+    result += " " + extractFirstOfPair(ops[0]) + ", " + ops[1] + ", " + ops[2];
+    // Append offset operands (skip ops[3] which is the second data reg)
+    for (size_t i = 4; i < ops.size(); ++i) {
+      if (ops[i].find("offset") != std::string::npos) {
+        result += " " + ops[i];
+      }
+    }
+  } else {
+    // Fallback: can't rewrite, return empty
+    return "";
+  }
+
+  return result;
+}

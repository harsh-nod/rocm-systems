+// ── gfx1250 B0→A0 in-place binary patches ────────────────────────────────────
+//
+// Three B0-emitted instructions cause hardware bugs on A0 silicon.  All patches
+// are same-size in-place opcode rewrites — no trampolines or LLVM MC needed.
+
+static uint32_t RetargetGfx1250B0toA0(uint8_t* text, uint64_t text_size) {
+  uint32_t patched = 0;
+
+  // ── Patch tables ───────────────────────────────────────────────────────────
+
+  // Patch 1: CLUSTER_LOAD → GLOBAL_LOAD (DEGFXMI400-12773)
+  // Format VGLOBAL: dw0 & 0xFF000000 == 0xEE000000, opcode bits[20:13], 12 bytes
+  struct VglobalMap { uint8_t from_op; uint8_t to_op; };
+  static const VglobalMap cluster_map[] = {
+    {103, 20},  // CLUSTER_LOAD_B32          → GLOBAL_LOAD_B32
+    {104, 21},  // CLUSTER_LOAD_B64          → GLOBAL_LOAD_B64
+    {105, 23},  // CLUSTER_LOAD_B128         → GLOBAL_LOAD_B128
+    {106, 95},  // CLUSTER_LOAD_ASYNC_TO_LDS_B8   → GLOBAL_LOAD_ASYNC_TO_LDS_B8
+    {107, 96},  // CLUSTER_LOAD_ASYNC_TO_LDS_B32  → GLOBAL_LOAD_ASYNC_TO_LDS_B32
+    {108, 97},  // CLUSTER_LOAD_ASYNC_TO_LDS_B64  → GLOBAL_LOAD_ASYNC_TO_LDS_B64
+    {109, 98},  // CLUSTER_LOAD_ASYNC_TO_LDS_B128 → GLOBAL_LOAD_ASYNC_TO_LDS_B128
+  };
+
+  // Patch 2: DS 2-address → single-address (DEGFXMI400-12320)
+  // Format VDS: dw0 & 0xFC000000 == 0xD8000000, opcode bits[25:18], 8 bytes
+  struct DsMap { uint8_t from_op; uint8_t to_op; };
+  static const DsMap ds_map[] = {
+    {0x37, 0x36},  // DS_LOAD_2ADDR_B32               → DS_LOAD_B32
+    {0x77, 0x76},  // DS_LOAD_2ADDR_B64               → DS_LOAD_B64
+    {0x38, 0x36},  // DS_LOAD_2ADDR_STRIDE64_B32      → DS_LOAD_B32
+    {0x78, 0x76},  // DS_LOAD_2ADDR_STRIDE64_B64      → DS_LOAD_B64
+    {0x0E, 0x0D},  // DS_STORE_2ADDR_B32              → DS_STORE_B32
+    {0x4E, 0x4D},  // DS_STORE_2ADDR_B64              → DS_STORE_B64
+    {0x0F, 0x0D},  // DS_STORE_2ADDR_STRIDE64_B32     → DS_STORE_B32
+    {0x4F, 0x4D},  // DS_STORE_2ADDR_STRIDE64_B64     → DS_STORE_B64
+    {0x2E, 0x2D},  // DS_STOREXCHG_2ADDR_RTN_B32      → DS_STOREXCHG_RTN_B32
+    {0x6E, 0x6D},  // DS_STOREXCHG_2ADDR_RTN_B64      → DS_STOREXCHG_RTN_B64
+    {0x2F, 0x2D},  // DS_STOREXCHG_2ADDR_STRIDE64_RTN_B32 → DS_STOREXCHG_RTN_B32
+    {0x6F, 0x6D},  // DS_STOREXCHG_2ADDR_STRIDE64_RTN_B64 → DS_STOREXCHG_RTN_B64
+  };
+
+  // Walk the text section in 4-byte steps, checking each dword for target formats
+  for (uint64_t off = 0; off + 4 <= text_size; ) {
+    uint32_t dw0;
+    std::memcpy(&dw0, text + off, 4);
+
+    // ── Patch 1: VGLOBAL format (12 bytes) ─────────────────────────────────
+    if ((dw0 & 0xFF000000u) == 0xEE000000u && off + 12 <= text_size) {
+      uint8_t opcode = (dw0 >> 13) & 0xFF;
+      for (const auto& m : cluster_map) {
+        if (opcode == m.from_op) {
+          dw0 = (dw0 & ~(0xFFu << 13)) | (static_cast<uint32_t>(m.to_op) << 13);
+          std::memcpy(text + off, &dw0, 4);
+          ++patched;
+          std::cerr << "hotswap: B0->A0 @0x" << std::hex << off
+                    << ": CLUSTER_LOAD op " << static_cast<int>(m.from_op)
+                    << " -> GLOBAL_LOAD op " << static_cast<int>(m.to_op)
+                    << std::dec << "\n";
+          break;
+        }
+      }
+      off += 12;
+      continue;
+    }
+
+    // ── Patch 2: VDS format (8 bytes) ──────────────────────────────────────
+    if ((dw0 & 0xFC000000u) == 0xD8000000u && off + 8 <= text_size) {
+      uint8_t opcode = (dw0 >> 18) & 0xFF;
+      for (const auto& m : ds_map) {
+        if (opcode == m.from_op) {
+          dw0 = (dw0 & ~(0xFFu << 18)) | (static_cast<uint32_t>(m.to_op) << 18);
+          std::memcpy(text + off, &dw0, 4);
+          ++patched;
+          std::cerr << "hotswap: B0->A0 @0x" << std::hex << off
+                    << ": DS_2ADDR op 0x" << static_cast<int>(m.from_op)
+                    << " -> 0x" << static_cast<int>(m.to_op)
+                    << std::dec << "\n";
+          break;
+        }
+      }
+      off += 8;
+      continue;
+    }
+
+    // ── Patch 3: SOPP s_clause → s_nop (SWDEV-546277, 4 bytes) ────────────
+    if ((dw0 & 0xFF800000u) == 0xBF800000u) {
+      uint8_t sopp_op = (dw0 >> 16) & 0x7F;
+      if (sopp_op == 0x05) { // s_clause
+        uint32_t s_nop = 0xBF800000u;
+        std::memcpy(text + off, &s_nop, 4);
+        ++patched;
+        std::cerr << "hotswap: B0->A0 @0x" << std::hex << off
+                  << ": s_clause -> s_nop" << std::dec << "\n";
+      }
+      off += 4;
+      continue;
+    }
+
+    off += 4;
+  }
+
+  return patched;
+}
+

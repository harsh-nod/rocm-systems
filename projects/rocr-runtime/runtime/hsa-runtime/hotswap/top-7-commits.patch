+/// @param gfx12        Use GFX12 encoding (opcode 0x20) vs GFX9 (opcode 0x02)
 /// @return             true if the offset fits in 16-bit signed range
 bool EncodeSBranch(uint64_t from_offset, uint64_t to_offset,
-                   uint8_t out_bytes[4]);

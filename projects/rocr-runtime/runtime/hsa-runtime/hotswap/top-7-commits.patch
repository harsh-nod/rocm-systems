+/// Find the nearest NOP sled with enough space for a trampoline.
+static NopSled* FindNearestSled(std::vector<NopSled>& sleds,
+                                 uint64_t offset, uint64_t needed) {
+  NopSled* best = nullptr;
+  int64_t best_dist = INT64_MAX;
+  for (auto& sled : sleds) {
+    if (sled.write_pos + needed > sled.end) continue;

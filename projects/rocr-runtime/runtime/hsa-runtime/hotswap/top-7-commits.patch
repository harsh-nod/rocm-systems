@@ -0,0 +1,348 @@
+////////////////////////////////////////////////////////////////////////////////
+//
+// Standalone unit tests for gfx1250 B0→A0 binary patches.
+// No LLVM dependency — exercises the patch logic directly on raw byte buffers.
+//
+// Build:  g++ -std=c++17 -O2 -o test_b0a0_standalone tests/test_b0a0_standalone.cpp
+// Run:    ./test_b0a0_standalone
+//
+////////////////////////////////////////////////////////////////////////////////
+
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <vector>
+
+// ── Embedded copy of RetargetGfx1250B0toA0 (identical to hotswap.cpp) ────────
+
+static uint32_t RetargetGfx1250B0toA0(uint8_t* text, uint64_t text_size) {
+  uint32_t patched = 0;
+
+  struct VglobalMap { uint8_t from_op; uint8_t to_op; };
+  static const VglobalMap cluster_map[] = {
+    {103, 20},  {104, 21},  {105, 23},
+    {106, 95},  {107, 96},  {108, 97},  {109, 98},
+  };
+
+  struct DsMap { uint8_t from_op; uint8_t to_op; };
+  static const DsMap ds_map[] = {
+    {0x37, 0x36}, {0x77, 0x76}, {0x38, 0x36}, {0x78, 0x76},
+    {0x0E, 0x0D}, {0x4E, 0x4D}, {0x0F, 0x0D}, {0x4F, 0x4D},
+    {0x2E, 0x2D}, {0x6E, 0x6D}, {0x2F, 0x2D}, {0x6F, 0x6D},
+  };
+
+  for (uint64_t off = 0; off + 4 <= text_size; ) {
+    uint32_t dw0;
+    std::memcpy(&dw0, text + off, 4);
+
+    if ((dw0 & 0xFF000000u) == 0xEE000000u && off + 12 <= text_size) {
+      uint8_t opcode = (dw0 >> 13) & 0xFF;
+      for (const auto& m : cluster_map) {
+        if (opcode == m.from_op) {
+          dw0 = (dw0 & ~(0xFFu << 13)) | (static_cast<uint32_t>(m.to_op) << 13);
+          std::memcpy(text + off, &dw0, 4);
+          ++patched;
+          break;
+        }
+      }
+      off += 12;
+      continue;
+    }
+
+    if ((dw0 & 0xFC000000u) == 0xD8000000u && off + 8 <= text_size) {
+      uint8_t opcode = (dw0 >> 18) & 0xFF;
+      for (const auto& m : ds_map) {
+        if (opcode == m.from_op) {
+          dw0 = (dw0 & ~(0xFFu << 18)) | (static_cast<uint32_t>(m.to_op) << 18);
+          std::memcpy(text + off, &dw0, 4);
+          ++patched;
+          break;
+        }
+      }
+      off += 8;
+      continue;
+    }
+
+    if ((dw0 & 0xFF800000u) == 0xBF800000u) {
+      uint8_t sopp_op = (dw0 >> 16) & 0x7F;
+      if (sopp_op == 0x05) {
+        uint32_t s_nop = 0xBF800000u;
+        std::memcpy(text + off, &s_nop, 4);
+        ++patched;
+      }
+      off += 4;
+      continue;
+    }
+
+    off += 4;
+  }
+
+  return patched;
+}
+
+// ── Test helpers ─────────────────────────────────────────────────────────────
+
+static uint32_t make_vglobal(uint8_t opcode, uint32_t other_bits = 0) {
+  return 0xEE000000u | (static_cast<uint32_t>(opcode) << 13) | (other_bits & 0x1FFFu);
+}
+
+static uint32_t make_vds(uint8_t opcode, uint32_t other_bits = 0) {
+  return 0xD8000000u | (static_cast<uint32_t>(opcode) << 18) | (other_bits & 0x3FFFFu);
+}
+
+static uint32_t make_sopp(uint8_t opcode, uint16_t imm = 0) {
+  return 0xBF800000u | (static_cast<uint32_t>(opcode) << 16) | imm;
+}
+
+// ── Tests ────────────────────────────────────────────────────────────────────
+
+static void TestClusterLoadPatch() {
+  struct Case { uint8_t from_op; uint8_t to_op; };
+  Case cases[] = {
+    {103, 20}, {104, 21}, {105, 23},
+    {106, 95}, {107, 96}, {108, 97}, {109, 98},
+  };
+
+  for (const auto& c : cases) {
+    uint32_t other = 0x1E03u;
+    uint32_t dw0 = make_vglobal(c.from_op, other);
+    uint32_t dw1 = 0xDEADBEEFu;
+    uint32_t dw2 = 0xCAFEBABEu;
+
+    uint8_t text[12];
+    std::memcpy(text + 0, &dw0, 4);
+    std::memcpy(text + 4, &dw1, 4);
+    std::memcpy(text + 8, &dw2, 4);
+
+    uint32_t count = RetargetGfx1250B0toA0(text, sizeof(text));
+    assert(count == 1);
+
+    uint32_t patched_dw0;
+    std::memcpy(&patched_dw0, text, 4);
+    uint32_t expected = make_vglobal(c.to_op, other);
+    assert(patched_dw0 == expected);
+
+    // dw1, dw2 untouched
+    uint32_t check1, check2;
+    std::memcpy(&check1, text + 4, 4);
+    std::memcpy(&check2, text + 8, 4);
+    assert(check1 == 0xDEADBEEFu);
+    assert(check2 == 0xCAFEBABEu);
+  }
+
+  // Non-matching VGLOBAL opcode should not be patched
+  {
+    uint32_t dw0 = make_vglobal(20, 0); // GLOBAL_LOAD_B32, not CLUSTER_LOAD
+    uint8_t text[12] = {};
+    std::memcpy(text, &dw0, 4);
+    assert(RetargetGfx1250B0toA0(text, sizeof(text)) == 0);
+  }
+
+  std::cout << "TestClusterLoadPatch: PASSED\n";
+}
+
+static void TestDs2AddrPatch() {
+  struct Case { uint8_t from_op; uint8_t to_op; };
+  Case cases[] = {
+    {0x37, 0x36}, {0x77, 0x76}, {0x38, 0x36}, {0x78, 0x76},
+    {0x0E, 0x0D}, {0x4E, 0x4D}, {0x0F, 0x0D}, {0x4F, 0x4D},
+    {0x2E, 0x2D}, {0x6E, 0x6D}, {0x2F, 0x2D}, {0x6F, 0x6D},
+  };
+
+  for (const auto& c : cases) {
+    uint32_t other = 0x2A5F7u;
+    uint32_t dw0 = make_vds(c.from_op, other);
+    uint32_t dw1 = 0x12345678u;
+
+    uint8_t text[8];
+    std::memcpy(text + 0, &dw0, 4);
+    std::memcpy(text + 4, &dw1, 4);
+
+    uint32_t count = RetargetGfx1250B0toA0(text, sizeof(text));
+    assert(count == 1);
+
+    uint32_t patched_dw0;
+    std::memcpy(&patched_dw0, text, 4);
+    uint32_t expected = make_vds(c.to_op, other);
+    assert(patched_dw0 == expected);
+
+    uint32_t check1;
+    std::memcpy(&check1, text + 4, 4);
+    assert(check1 == 0x12345678u);
+  }
+
+  // Non-matching DS opcode should not be patched
+  {
+    uint32_t dw0 = make_vds(0x36, 0); // DS_LOAD_B32, not 2-addr
+    uint8_t text[8] = {};
+    std::memcpy(text, &dw0, 4);
+    assert(RetargetGfx1250B0toA0(text, sizeof(text)) == 0);
+  }
+
+  std::cout << "TestDs2AddrPatch: PASSED\n";
+}
+
+static void TestSClausePatch() {
+  // s_clause 42 → s_nop 0
+  {
+    uint32_t s_clause = make_sopp(0x05, 42);
+    uint8_t text[4];
+    std::memcpy(text, &s_clause, 4);
+
+    uint32_t count = RetargetGfx1250B0toA0(text, sizeof(text));
+    assert(count == 1);
+
+    uint32_t patched;
+    std::memcpy(&patched, text, 4);
+    assert(patched == 0xBF800000u);
+  }
+
+  // s_nop 0 should NOT be patched (opcode 0x00, not 0x05)
+  {
+    uint32_t s_nop = 0xBF800000u;
+    uint8_t text[4];
+    std::memcpy(text, &s_nop, 4);
+
+    uint32_t count = RetargetGfx1250B0toA0(text, sizeof(text));
+    assert(count == 0);
+
+    uint32_t check;
+    std::memcpy(&check, text, 4);
+    assert(check == 0xBF800000u);
+  }
+
+  // Other SOPP opcodes (e.g. s_endpgm = 0x01) should not be patched
+  {
+    uint32_t s_endpgm = make_sopp(0x01, 0);
+    uint8_t text[4];
+    std::memcpy(text, &s_endpgm, 4);
+
+    uint32_t count = RetargetGfx1250B0toA0(text, sizeof(text));
+    assert(count == 0);
+  }
+
+  std::cout << "TestSClausePatch: PASSED\n";
+}
+
+static void TestB0A0ByteBufferPatch() {
+  // 32-byte buffer with one of each instruction type:
+  //   [0..11]   CLUSTER_LOAD_B32 (op 103, 12 bytes)
+  //   [12..19]  DS_STORE_2ADDR_B32 (op 0x0E, 8 bytes)
+  //   [20..23]  s_clause 7 (4 bytes)
+  //   [24..27]  s_nop 0 (should NOT be patched)
+
+  uint8_t text[28];
+  std::memset(text, 0, sizeof(text));
+
+  uint32_t vglobal = make_vglobal(103, 0x07);
+  std::memcpy(text + 0, &vglobal, 4);
+  uint32_t vg_dw1 = 0xAAAAAAAAu;
+  std::memcpy(text + 4, &vg_dw1, 4);
+  uint32_t vg_dw2 = 0xBBBBBBBBu;
+  std::memcpy(text + 8, &vg_dw2, 4);
+
+  uint32_t ds = make_vds(0x0E, 0x1234);
+  std::memcpy(text + 12, &ds, 4);
+  uint32_t ds_dw1 = 0xCCCCCCCCu;
+  std::memcpy(text + 16, &ds_dw1, 4);
+
+  uint32_t sclause = make_sopp(0x05, 7);
+  std::memcpy(text + 20, &sclause, 4);
+
+  uint32_t snop = 0xBF800000u;
+  std::memcpy(text + 24, &snop, 4);
+
+  uint32_t count = RetargetGfx1250B0toA0(text, 28);
+  assert(count == 3);
+
+  // Verify CLUSTER_LOAD_B32 → GLOBAL_LOAD_B32 (op 20)
+  uint32_t p0;
+  std::memcpy(&p0, text + 0, 4);
+  assert(p0 == make_vglobal(20, 0x07));
+
+  // Verify DS_STORE_2ADDR_B32 → DS_STORE_B32 (op 0x0D)
+  uint32_t p1;
+  std::memcpy(&p1, text + 12, 4);
+  assert(p1 == make_vds(0x0D, 0x1234));
+
+  // Verify s_clause → s_nop
+  uint32_t p2;
+  std::memcpy(&p2, text + 20, 4);
+  assert(p2 == 0xBF800000u);
+
+  // Verify original s_nop untouched
+  uint32_t p3;
+  std::memcpy(&p3, text + 24, 4);
+  assert(p3 == 0xBF800000u);
+
+  // Verify dw1/dw2 untouched
+  uint32_t c1, c2, c3;
+  std::memcpy(&c1, text + 4, 4);
+  std::memcpy(&c2, text + 8, 4);
+  std::memcpy(&c3, text + 16, 4);
+  assert(c1 == 0xAAAAAAAAu);
+  assert(c2 == 0xBBBBBBBBu);
+  assert(c3 == 0xCCCCCCCCu);
+
+  std::cout << "TestB0A0ByteBufferPatch: PASSED\n";
+}
+
+static void TestEdgeCases() {
+  // Empty buffer
+  {
+    uint32_t count = RetargetGfx1250B0toA0(nullptr, 0);
+    assert(count == 0);
+  }
+
+  // Buffer too small for any instruction (3 bytes)
+  {
+    uint8_t text[3] = {0xEE, 0x00, 0x00};
+    uint32_t count = RetargetGfx1250B0toA0(text, 3);
+    assert(count == 0);
+  }
+
+  // VGLOBAL at end of buffer with insufficient room (only 8 bytes, need 12)
+  {
+    uint32_t dw0 = make_vglobal(103, 0);
+    uint8_t text[8] = {};
+    std::memcpy(text, &dw0, 4);
+    // Since off + 12 > text_size (8), the VGLOBAL check won't match.
+    // It falls through to other checks. dw0 starts with 0xEE which doesn't
+    // match VDS (0xD8) or SOPP (0xBF8), so it advances by 4.
+    uint32_t count = RetargetGfx1250B0toA0(text, 8);
+    assert(count == 0);
+  }
+
+  // Two consecutive s_clause instructions
+  {
+    uint32_t sc1 = make_sopp(0x05, 3);
+    uint32_t sc2 = make_sopp(0x05, 10);
+    uint8_t text[8];
+    std::memcpy(text + 0, &sc1, 4);
+    std::memcpy(text + 4, &sc2, 4);
+    uint32_t count = RetargetGfx1250B0toA0(text, 8);
+    assert(count == 2);
+
+    uint32_t p0, p1;
+    std::memcpy(&p0, text + 0, 4);
+    std::memcpy(&p1, text + 4, 4);
+    assert(p0 == 0xBF800000u);
+    assert(p1 == 0xBF800000u);
+  }
+
+  std::cout << "TestEdgeCases: PASSED\n";
+}
+
+// ── Main ─────────────────────────────────────────────────────────────────────
+
+int main() {
+  TestClusterLoadPatch();
+  TestDs2AddrPatch();
+  TestSClausePatch();
+  TestB0A0ByteBufferPatch();
+  TestEdgeCases();
+
+  std::cout << "\nAll B0->A0 standalone tests passed.\n";
+  return 0;
+}
